---
import { ui } from "../data/ui";
import { sitePath } from "../utils/paths";
import Copy from "../components/Copy.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { arrangementServiceId, getServices, serviceDetails } from "../data/services";
import { contactInquiryId } from "../data/site";
const services = (await getServices()).sort((a, b) => Number(b.id === arrangementServiceId) - Number(a.id === arrangementServiceId));
const contactPath = sitePath(`/contact/#${contactInquiryId}`);
const posterPath = sitePath("/images/services/commission-price-list.jpg");
const priceNumber = new Intl.NumberFormat("zh-TW");
---

<BaseLayout
  title="單曲編曲、音樂製作與劇場音樂設計｜申承羲 Manfred Sun"
  description="申承羲提供單曲編曲服務。查看新台幣參考價、編曲音檔交付內容與實際作品，了解如何洽詢編曲、音樂製作或劇場音樂設計。"
  canonicalPath="/services/"
>
  <section class="page-hero shell services-hero">
    <h1 class="display">合作服務</h1>
    <Copy name="services/intro" as="p" class="page-hero__lede" />
    <div class="services-actions">
      <a class="button button--primary" href={contactPath}>{ui.requestQuote} <span aria-hidden="true">↗</span></a>
      <a class="button" href="#service-list">查看服務 <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section id="service-list" class="services-section shell" aria-labelledby="service-list-title">
    <h2 id="service-list-title" class="section-title">服務項目</h2>
    <p class="services-price-note">價目以新台幣（TWD）計，僅供參考。實際報價以雙方確認為準。</p>
    <div class="services-grid">
      {services.map((service) => {
        const details = serviceDetails[service.id];
        const price = details?.price;
        const amount = price && priceNumber.format(price.amount);
        const isArrangement = service.id === arrangementServiceId;
        return (
          <article class="service-card">
            <h3>{service.data.title}</h3>
            <p class="service-price">
              {price ? <><strong>NT${amount}／{price.unit}</strong>{price.label && <span>{price.label}</span>}</> : "個別報價"}
            </p>
            <Copy name={service.id} label={service.data.title} class="service-summary" />
            {details && <dl class="service-delivery">
              {isArrangement && price ? <>
                <dt>編曲一首多少錢？</dt>
                <dd>單曲編曲參考價為每{price.unit}新台幣 {amount} 元，交付{details.deliverables}。實際報價依編制、工作量與所需版本確認。</dd>
              </> : <>
                <dt>可交付內容</dt>
                <dd>{details.deliverables}</dd>
              </>}
            </dl>}
            {details?.examples?.map((example) => <div class="service-case">
              <a class="service-example" href={sitePath(example.path)}>{example.label} <span aria-hidden="true">↗</span></a>
              {example.description && <p>{example.description}</p>}
            </div>)}
          </article>
        );
      })}
    </div>
  </section>
  <section class="services-section shell" aria-labelledby="service-terms-title">
    <div class="services-terms">
      <h2 id="service-terms-title">報價與交期</h2>
      <dl>
        <div><dt>報價</dt><dd>按委託內容及工作量個別報價。</dd></div>
        <div><dt>交期</dt><dd>按製作內容及工作量確認。</dd></div>
        <div><dt>合作前確認</dt><dd>修改次數、交付格式及付款安排。</dd></div>
      </dl>
    </div>
  </section>
  <section class="services-cta shell" aria-labelledby="service-contact-title">
    <Copy name="services/contact-heading" as="h2" id="service-contact-title" />
    <p>洽詢時可附上專案簡介、所需服務、預計交期、交付需求及預算範圍。</p>
    <div class="services-actions">
      <a class="button button--primary" href={contactPath}>{ui.requestQuote} <span aria-hidden="true">↗</span></a>
      <a class="service-example" href={posterPath}>查看完整價目表 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero {
    min-height: 0;
    padding-block: calc(var(--header-height) + clamp(2.5rem, 7vw, 6rem)) clamp(2rem, 5vw, 4rem);
  }
  .services-hero :global(.page-hero__lede) { margin-top: 1.5rem; }
  .services-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.5rem; }
  .services-section { padding-block-start: clamp(2rem, 5vw, 4rem); }
  #service-list { scroll-margin-top: var(--header-height); }
  .services-section .section-title { font-size: clamp(1.75rem, 3.5vw, 3rem); }
  .services-price-note { margin: .75rem 0 1.5rem; color: var(--muted-ink); }
  .services-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .service-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: clamp(1.25rem, 2.8vw, 2.25rem);
    border: 1px solid var(--separator);
    border-block-start: 2px solid var(--accent);
    border-radius: .5rem;
    background: var(--surface);
  }
  .service-card h3, .services-terms h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.2;
  }
  .service-card :global(.service-summary) { color: var(--muted-ink); margin-top: .75rem; }
  .service-card :global(.service-summary p) { margin: 0; }
  .service-price { margin: .75rem 0 0; color: var(--accent); font-weight: 700; }
  .service-price strong { font-size: 1.25rem; }
  .service-price span { display: block; color: var(--muted-ink); font-size: .9rem; font-weight: 400; }
  .service-delivery { margin: auto 0 0; padding-top: 1.25rem; }
  .service-delivery dt { border-top: 1px solid var(--separator); padding-top: .85rem; }
  .service-delivery dd, .services-terms dd { margin: 0; color: var(--muted-ink); }
  .service-delivery dt, .services-terms dt { font-weight: 700; }
  .service-example {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    align-self: flex-start;
    min-height: 2.75rem;
    font-size: .9rem;
    font-weight: 700;
    color: var(--accent);
  }
  .service-card .service-example { margin-top: .35rem; }
  .service-case > p { margin: 0; color: var(--muted-ink); }
  .services-terms {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--separator);
    border-radius: .5rem;
    background: color-mix(in srgb, var(--surface), var(--accent) 4%);
  }
  .services-terms dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 1rem 0 0; }
  .services-cta { padding-block: clamp(3rem, 7vw, 6rem); }
  .services-cta :global(h2) { margin: 0; font-family: var(--serif); font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.2; }
  .services-cta > p { margin: .75rem 0 0; color: var(--muted-ink); }
  @media (max-width: 62rem) { .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) {
    .services-grid, .services-terms dl { grid-template-columns: minmax(0, 1fr); }
  }
</style>
