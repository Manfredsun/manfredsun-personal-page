---
import { sitePath } from "../../utils/paths";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Copy from "../../components/Copy.astro";
import EmptySlot from "../../components/EmptySlot.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import { publicProjects } from "../../data/credits";
import { categoryLabels } from "../../data/portfolio";

export async function getStaticPaths() {
  const works = await getCollection("works", ({ data }) => data.case_study && data.verification === "verified");
  return works.map((work) => ({ params: { slug: work.data.slug }, props: { work } }));
}
interface Props { work: CollectionEntry<"works">; }
const { work } = Astro.props;
const { data } = work;
const workCredit = publicProjects.find((credit) => credit.work_slug === data.slug);
const credits = data.credits.filter((credit) => credit.verified && (credit.artist || credit.company));
const runs = data.runs.filter((run) => run.verified);
const source = `src/content/works/${data.slug}.md`;
const isSelectedWorks = data.page_type === "selected-works";
const roles = workCredit?.roles.length ? workCredit.roles : [...new Set(data.selected_works.flatMap((item) => item.role?.split(" · ") ?? []))];
const isGalangal = data.slug === "galangal-lemongrass-poppies";
const isAfterSwipingRight = data.slug === "after-swiping-right";
const roleAfterIntro = isGalangal || isAfterSwipingRight;
const showHeaderPoster = Boolean(data.hero_image) && roleAfterIntro;
---
<BaseLayout title={`${data.title} — Manfred Sun`} description={data.summary || `申承羲 Manfred Sun 的作品：${data.title}。`} canonicalPath={`/works/${data.slug}/`} image={data.hero_image || data.cover}>
  <article class="case-study shell">
    <header class:list={["case-study__header", { "case-study__header--poster": showHeaderPoster }]}>
      {showHeaderPoster && data.hero_image && <figure class="case-study__poster"><img src={sitePath(data.hero_image)} alt={data.hero_alt || data.title} width={isAfterSwipingRight ? 1206 : 1080} height={isAfterSwipingRight ? 1606 : 1080} fetchpriority="high" /></figure>}
      <div class="case-study__heading">
      {roles.length > 0 && !roleAfterIntro && <p class="case-study__role"><span>My Role</span> {roles.join(" · ")}</p>}
      <p class="eyebrow">{categoryLabels[data.category]}</p>
      <h1 class="display">{data.title}</h1>
      <Copy collection="workCopy" name={`${data.slug}/intro`} label="作品簡介" class="case-study__intro prose" />
      {roles.length > 0 && roleAfterIntro && <p class="case-study__role case-study__role--after-intro"><span>My Role</span> {roles.join(" · ")}</p>}
      </div>
    </header>
    {!showHeaderPoster && (data.hero_image ? <figure class="project-hero"><img src={sitePath(data.hero_image)} alt={data.hero_alt || data.title} width="1600" height="1000" decoding="async" fetchpriority="high" /></figure> : !isSelectedWorks && <EmptySlot label="作品主圖" source={`${source} → hero_image / hero_alt`} />)}
    <dl class="case-study__metadata">
      <div><dt>Category</dt><dd>{categoryLabels[data.category]}</dd></div>
      {data.artist && <div><dt>Artist</dt><dd>{data.artist}</dd></div>}
      {data.company && <div><dt>Company</dt><dd>{data.company}</dd></div>}
      {data.year && <div><dt>Year</dt><dd>{data.year}</dd></div>}
    </dl>
    {isSelectedWorks ? <>
      <Copy collection="workCopy" name={`${data.slug}/description`} title="合作簡介" class="case-study__section prose" />
      <section class="case-study__section selected-works" aria-labelledby="selected-works-title">
        <p class="eyebrow">Selected Works</p>
        <h2 id="selected-works-title">Selected Works</h2>
        <ol class="selected-works__list">
          {data.selected_works.map((item, index) => (
            <li>
              {item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">
                <span class="selected-works__number">{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.title}</strong>
                <span class="selected-works__meta">{[item.role, item.year].filter(Boolean).join(" · ")}</span>
                <span class="selected-works__arrow" aria-hidden="true">↗</span>
              </a> : <div>
                <span class="selected-works__number">{String(index + 1).padStart(2, "0")}</span>
                <strong>{item.title}</strong>
                <span class="selected-works__meta">{[item.role, item.year].filter(Boolean).join(" · ")}</span>
              </div>}
            </li>
          ))}
        </ol>
      </section>
    </> : <>
      <Copy collection="workCopy" name={`${data.slug}/description`} title="作品描述" class="case-study__section prose" />
      <Copy collection="workCopy" name={`${data.slug}/architecture`} title="專案架構" class="case-study__section prose" />
      <Copy collection="workCopy" name={`${data.slug}/concept`} title="創作概念" class="case-study__section prose" fallback={data.concept} />
      <Copy collection="workCopy" name={`${data.slug}/sound-language`} title="音樂與聲音語言" class="case-study__section prose" fallback={data.sound_language} />
      <Copy collection="workCopy" name={`${data.slug}/process`} title="製作過程" class="case-study__section prose" fallback={data.process} />
      <ProjectMedia work={work} />
      {credits.length ? <section class="case-study__section" aria-label="製作名單"><h2>製作名單</h2><ul class="case-study__list">
        {credits.map((credit) => <li><strong>{credit.role}</strong><span>{[credit.artist, credit.company].filter(Boolean).join(" · ")}</span></li>)}
      </ul></section> : <EmptySlot label="製作名單" source={`${source} → credits`} />}
      {runs.length ? <section class="case-study__section" aria-label="演出與發行版本"><h2>演出與發行版本</h2><ul class="case-study__list">
        {runs.map((run) => <li><strong>{run.label}</strong>{run.year && <span>{run.year}</span>}</li>)}
      </ul></section> : <EmptySlot label="演出與發行版本" source={`${source} → runs`} />}
    </>}
    {data.external_links.length ? <nav aria-label="Project links" class="case-study__links">
      {data.external_links.map((link) => <a class="button" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
    </nav> : <EmptySlot label="外部來源與作品連結" source={`${source} → external_links`} />}
    <a class="text-link" href={sitePath("/credits/")}>← Previous Work List</a>
  </article>
</BaseLayout>
<style is:global>
  .project-hero { margin: 3rem 0 0; }
  .project-hero img { width: 100%; height: auto; }
  .case-study { padding-block: calc(var(--header-height) + clamp(5rem, 10vw, 9rem)) clamp(6rem, 12vw, 10rem); }
  .case-study__header { max-width: 62rem; padding-bottom: clamp(4rem, 9vw, 8rem); border-bottom: 1px solid var(--separator); }
  .case-study__header--poster { max-width: none; display: grid; grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); align-items: start; gap: clamp(2rem, 5vw, 5rem); }
  .case-study__poster { margin: 0; }
  .case-study__poster img { display: block; width: 100%; height: auto; }
  .case-study__role { margin: 0 0 1.5rem; font-size: clamp(1rem, 1.6vw, 1.25rem); font-weight: 700; }
  .case-study__role span { display: block; margin-bottom: .35rem; color: var(--muted-ink); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
  .case-study__role--after-intro { margin: 2rem 0 0; }
  .case-study__metadata { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.5rem; margin: 0; padding-block: 2rem 5rem; }
  .case-study__metadata div { display: grid; gap: .4rem; }
  .case-study__metadata dt { color: var(--muted-ink); font-size: .8125rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .case-study__metadata dd { margin: 0; }
  .case-study__intro { max-width: 42rem; margin-top: 2rem; font-size: clamp(1.1rem, 2vw, 1.45rem); }
  .prose { max-width: 42rem; overflow-wrap: anywhere; color: var(--muted-ink); line-height: 1.7; }
  .prose p { margin: 0 0 1.25em; }
  .prose p:last-child { margin-bottom: 0; }
  .prose ul, .prose ol { padding-left: 1.5em; }
  .prose li + li { margin-top: .5em; }
  .prose a { color: var(--accent); }
  .case-study__section { max-width: 48rem; margin-bottom: 5rem; }
  .case-study h2 { margin: .5rem 0 1.5rem; font-family: var(--serif); font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; }
  .case-study__list { margin: 0; padding: 0; border-top: 1px solid var(--separator); list-style: none; }
  .case-study__list li { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--separator); }
  .case-study__list span { color: var(--muted-ink); }
  .case-study__list strong, .case-study__list span { overflow-wrap: anywhere; }
  .case-study__links { display: flex; flex-wrap: wrap; gap: .8rem; margin-bottom: 4rem; }
  .selected-works { max-width: none; }
  .selected-works__list { margin: 0; padding: 0; border-top: 1px solid var(--separator); list-style: none; }
  .selected-works__list li { border-bottom: 1px solid var(--separator); }
  .selected-works__list a,
  .selected-works__list li > div {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(8rem, auto) auto;
    gap: 1.25rem;
    align-items: center;
    min-height: 8rem;
    padding-block: 1.25rem;
    text-decoration: none;
  }
  .selected-works__number,
  .selected-works__meta { color: var(--muted-ink); font-size: .875rem; }
  .selected-works__list strong { font-family: var(--serif); font-size: clamp(1.55rem, 3vw, 2.8rem); font-weight: 500; line-height: 1.05; }
  .selected-works__arrow { font-size: 1.15rem; transition: transform 180ms ease; }
  .selected-works__list a:hover .selected-works__arrow { transform: translate(0.2rem, -0.2rem); }
  @media (max-width: 42rem) {
    .case-study__header--poster { grid-template-columns: minmax(0, 1fr); }
    .case-study__poster { max-width: 24rem; }
    .case-study__header--poster .case-study__heading { order: -1; }
    .case-study__list li { display: grid; }
    .selected-works__list a,
    .selected-works__list li > div {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      min-height: 7rem;
    }
    .selected-works__meta { grid-column: 2; }
    .selected-works__arrow { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
