---
import { sitePath } from "../utils/paths";
import Copy from "../components/Copy.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { sortWorks, publicRoles } from "../data/portfolio";

const selectedWorks = sortWorks((await getCollection("works")).filter(({ data }) => data.case_study && data.verification === "verified"));
---

<BaseLayout
  title="About 申承羲 Manfred Sun — 作曲、音樂製作與劇場聲音"
  description="認識來自香港、現於台灣工作的作曲家、編曲師、音樂製作人申承羲 Manfred Sun。"
  canonicalPath="/about/"
>
  <section class="page-hero shell">
    <p class="eyebrow">Profile</p>
    <h1 class="display">About</h1>
    <Copy name="about/intro" as="p" class="page-hero__lede" />
  </section>
  <section class="about-body shell" aria-label="個人介紹">
    <div class="about-body__lead">
      <p class="eyebrow">Manfred Sun / 申承羲</p>
      <Copy name="about/heading" as="h2" />
    </div>
    <div class="about-body__copy">
      <Copy name="about/bio" as="p" />
      <Copy name="about/story" as="p" />
      <a class="text-link" href={sitePath("/services/")}>Explore services <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="about-work shell" aria-labelledby="about-work-title">
    <p class="eyebrow">Selected Experience</p>
    <h2 id="about-work-title">作品與職務</h2>
    <ul>
      {selectedWorks.map((work) => <li><a href={sitePath(`/works/${work.data.slug}/`)}>{work.data.title}</a><span>{publicRoles(work).join(" · ")}</span></li>)}
    </ul>
    <a class="text-link" href={sitePath("/credits/")}>Previous Work List <span aria-hidden="true">→</span></a>
  </section>
  <section class="shell optional-sections" aria-label="更多背景">
    <Copy name="about/areas" title="工作領域" class="optional-copy" />
    <Copy name="about/background" title="背景" class="optional-copy" />
    <Copy name="about/languages" title="語言" class="optional-copy" />
  </section>
</BaseLayout>

<style is:global>
  .about-body { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 7vw, 8rem); padding-block: clamp(5rem, 11vw, 9rem); }
  .about-body h2 { max-width: 14ch; margin: 1rem 0 0; font-family: var(--serif); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.1; }
  .about-body__copy { max-width: 37rem; font-size: clamp(1.1rem, 1.6vw, 1.3rem); }
  .about-body__copy p { margin: 0 0 1.5rem; }
  .about-body__copy p + p { color: var(--muted-ink); }
  .about-work { padding-bottom: clamp(6rem, 12vw, 10rem); }
  .about-work h2 { margin: .5rem 0 2rem; font-family: var(--serif); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 500; }
  .about-work ul { margin: 0 0 2rem; padding: 0; border-top: 1px solid var(--separator); list-style: none; }
  .about-work li { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1.25rem 0; border-bottom: 1px solid var(--separator); }
  .about-work li a { font-family: var(--serif); font-size: clamp(1.25rem, 2vw, 1.8rem); }
  .about-work li span { color: var(--muted-ink); }
  @media (max-width: 48rem) { .about-body { grid-template-columns: 1fr; } .about-work li { display: grid; } }
</style>
