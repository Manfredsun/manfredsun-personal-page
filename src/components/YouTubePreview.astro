---
interface Props { title: string; videoId: string; }
const { title, videoId } = Astro.props;
---
<div class="youtube-preview" data-youtube-preview>
  <a href={`https://youtu.be/${videoId}`} target="_blank" rel="noopener noreferrer" data-youtube-id={videoId} aria-label={`播放 ${title} 影片`}>
    <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="youtube-preview__play" aria-hidden="true">▶</span>
  </a>
</div>
<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-youtube-id]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const container = link.closest("[data-youtube-preview]");
      if (!container || !link.dataset.youtubeId) return;
      event.preventDefault();
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtubeId}?autoplay=1`;
      iframe.title = link.getAttribute("aria-label") || "YouTube 影片";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      container.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
<style>
  .youtube-preview { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: .4rem; background: #29292d; }
  a { position: absolute; inset: 0; display: block; }
  a:focus-visible { outline-offset: -4px; }
  img { width: 100%; height: 100%; object-fit: cover; }
  .youtube-preview__play { position: absolute; top: 50%; left: 50%; display: grid; width: 3.2rem; height: 3.2rem; place-items: center; padding-left: .15rem; border: 1px solid rgb(255 255 255 / 70%); border-radius: 50%; background: rgb(20 20 22 / 75%); color: white; transform: translate(-50%, -50%); }
  a:hover .youtube-preview__play { background: #9d2f22; }
  .youtube-preview :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
</style>
