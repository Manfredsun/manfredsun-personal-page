---
import { sitePath } from "../utils/paths";
import type { CollectionEntry } from "astro:content";
interface Props { product: CollectionEntry<"products">; }
const { product } = Astro.props;
const { data, id } = product;
const headingId = `product-${id}`;
const statusId = `${headingId}-status`;
---

<article class="product-entry" aria-labelledby={headingId}>
  <div class="product-entry__copy">
    <p class="eyebrow">{data.category}</p>
    <h2 id={headingId}>{data.title}</h2>
    <p class="product-entry__positioning">{data.positioning}</p>
    {data.summary && <p class="product-entry__summary">{data.summary}</p>}
    <p class="product-entry__workflow">{data.workflow}</p>
    {data.creator_context && <p class="product-entry__creator">{data.creator_context}</p>}
  </div>
  <figure class="product-entry__visual">
    {data.screenshot ? <img
      src={sitePath(data.screenshot.src)}
      alt={data.screenshot.alt}
      width={data.screenshot.width}
      height={data.screenshot.height}
      loading="lazy"
      decoding="async"
    /> : <div class="product-entry__placeholder" data-product-placeholder>
      <p>{data.title}</p>
      <span>產品畫面待補</span>
    </div>}
  </figure>
  <div class="product-entry__cta">
    {data.site_url ? <a class="button" href={data.site_url} target="_blank" rel="noopener noreferrer">Visit Product Site <span aria-hidden="true">↗</span></a> : <>
      <button class="button product-entry__disabled" type="button" disabled aria-describedby={statusId} data-product-cta>Visit Product Site <span aria-hidden="true">↗</span></button>
      <p id={statusId}>產品網站尚未公開</p>
    </>}
    {data.repository_url && <a class="button" href={data.repository_url} target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>}
  </div>
</article>

<style>
  .product-entry { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .product-entry + .product-entry { margin-top: 5rem; padding-top: 5rem; border-top: 1px solid var(--separator); }
  .product-entry__copy { min-width: 0; overflow-wrap: anywhere; }
  h2 { margin: .8rem 0 1.5rem; font-family: var(--serif); font-size: clamp(2.35rem, 4.5vw, 4.75rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.08; }
  .product-entry__positioning { margin: 0 0 1.25rem; font-weight: 650; }
  .product-entry__summary { max-width: 32rem; margin: 0 0 2rem; color: var(--muted-ink); font-size: 1.1rem; }
  .product-entry__workflow { margin: 0; font-size: clamp(1.1rem, 1.6vw, 1.4rem); font-weight: 650; }
  .product-entry__creator { margin: 1.5rem 0 0; color: var(--muted-ink); font-size: .9375rem; }
  .product-entry__visual { min-width: 0; margin: 0; }
  img { width: 100%; height: auto; }
  .product-entry__placeholder { display: grid; width: 100%; min-height: 18rem; aspect-ratio: 16 / 10; align-content: center; justify-items: center; gap: .75rem; padding: 2rem; border: 1px solid var(--separator); background: var(--surface); text-align: center; overflow-wrap: anywhere; }
  .product-entry__placeholder p { margin: 0; font-family: var(--serif); font-size: clamp(1.4rem, 2vw, 2rem); line-height: 1.3; }
  .product-entry__placeholder span { color: var(--muted-ink); font-size: .9375rem; }
  .product-entry__cta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .product-entry__cta p { margin: 0; color: var(--muted-ink); font-size: .9375rem; }
  .product-entry__disabled, .product-entry__disabled:hover, .product-entry__disabled:active { background: transparent; color: var(--muted-ink); transform: none; cursor: default; transition: none; }
  @media (max-width: 48rem) { .product-entry { grid-template-columns: minmax(0, 1fr); } .product-entry__placeholder { min-height: 14rem; } }
</style>
