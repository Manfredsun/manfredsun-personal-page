---
import { sitePath } from "../utils/paths";
import PreviewControls from "../components/PreviewControls.astro";
import { site } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  image,
  noindex = false,
} = Astro.props;

const canonical = new URL(sitePath(canonicalPath), Astro.site);
const shareImage = site.social_image.trim() || image;
const socialImage = shareImage ? new URL(sitePath(shareImage), Astro.site) : undefined;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F5F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E10" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={site.social_image_alt || `${site.name} ${site.alternate_name}`} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <PreviewControls />}
  </body>
</html>
